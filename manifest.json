{
  "manifest_version": 3,
  "version": "1.0.0",
  "name": "Egglist",
  "description": "Shows scam-warning signals on Craigslist listings",
  "permissions": ["storage"],
  "host_permissions": [
    "https://craigslist.org/*",
    "https://*.craigslist.org/*",
    "https://craigslist.com/*",
    "https://*.craigslist.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16":"icons/egglist_icon16x16.png",
    "48":"icons/egglist_icon48x48.png",
    "128":"icons/egglist_icon128x128.png"
  },
  "content_scripts": [{
    "matches": [
      "https://craigslist.org/*",
      "https://*.craigslist.org/*",
      "https://craigslist.com/*",
      "https://*.craigslist.com/*"
    ],
    "js": [
      "content.js"
    ]
  }]
}